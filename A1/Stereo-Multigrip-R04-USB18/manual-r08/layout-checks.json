        632.8208661417323,
        175.7080078125,
        644.0708661417323
      ]
    },
    {
      "page": 6,
      "text": "Kamera · 9,5 mm",
      "bbox": [
        53.91162109375,
        682.5,
        150.08837890625,
        695
      ]
    },
    {
      "page": 6,
      "text": "16 mm",
      "bbox": [
        339,
        614.3956692913385,
        370.84716796875,
        625.6456692913385
      ]
    },
    {
      "page": 6,
      "text": "Batteriramme · 16 mm",
      "bbox": [
        236.3134765625,
        682.5,
        363.6865234375,
        695
      ]
    },
    {
      "page": 6,
      "text": "Same pinne ved alle festa",
      "bbox": [
        431.91015625,
        515.0,
        536.08984375,
        525
      ]
    },
    {
      "page": 6,
      "text": "Kilane er viste i same målestokk, 2:1.",
      "bbox": [
        42,
        474.75,
        211.32568359375003,
        486
      ]
    },
    {
      "page": 6,
      "text": "1 · Pinne",
      "bbox": [
        94.25146484375,
        420.5,
        143.74853515625,
        433
      ]
    },
    {
      "page": 6,
      "text": "2 · Kort kile",
      "bbox": [
        265.08984375,
        420.5,
        330.91015625,
        433
      ]
    },
    {
      "page": 6,
      "text": "3 · På plass",
      "bbox": [
        444.74169921875,
        420.5,
        509.25830078125,
        433
      ]
    },
    {
      "page": 6,
      "text": "Prøv éin bakhaldar mot beraren. Pinnen skal gli gjennom begge sidene; kilen skal gli inn i tverrsporet.",
      "bbox": [
        42,
        183.5,
        553.1328125,
        196
      ]
    },
    {
      "page": 6,
      "text": "Ikkje vri eller bruk makt.",
      "bbox": [
        42,
        168.5,
        164.3046875,
        181
      ]
    },
    {
      "page": 6,
      "text": "Ta ut kilen, så pinnen. Fjern bakhaldaren igjen. Begge bakhaldarane skal vere ute før korta",
      "bbox": [
        42,
        110.625,
        533.611083984375,
        122.5
      ]
    },
    {
      "page": 6,
      "text": "blir plasserte.",
      "bbox": [
        42,
        95.625,
        116.80322265625,
        107.5
      ]
    },
    {
      "page": 7,
      "text": "Kontroller korta",
      "bbox": [
        42,
        763.6397637795277,
        267.87890625,
        794.8897637795277
      ]
    },
    {
      "page": 7,
      "text": "7",
      "bbox": [
        42,
        23.25,
        46.45361328125,
        32
      ]
    },
    {
      "page": 7,
      "text": "ENTROPI R04 USB18 / 08",
      "bbox": [
        442.27559055118115,
        23.375,
        523.8112350824312,
        31.5
      ]
    },
    {
      "page": 7,
      "text": "Korta skal kome fritt på plass.",
      "bbox": [
        42,
        244.75,
        264.5615234375,
        261
      ]
    },
    {
      "page": 7,
      "text": "Teikninga viser sluttplasseringa. Rett innføring bakfrå kolliderer i CAD. Ein annan innføringsveg er",
      "bbox": [
        42,
        214.5,
        533.4501953125,
        227
      ]
    },
    {
      "page": 7,
      "text": "ikkje verifisert.",
      "bbox": [
        42,
        199.5,
        116.3017578125,
        212
      ]
    },
    {
      "page": 7,
      "text": "Hald fram berre når dei faktiske korta kjem fritt på plass. Ikkje press eller bøy dei.",
      "bbox": [
        42,
        152.5,
        510.017578125,
        165
      ]
    },
    {
      "page": 7,
      "text": "USB er fråkopla. Berre korta og den reine beraren er lagde fram.",
      "bbox": [
        59,
        86.625,
        366.97998046875,
        98.5
      ]
    },
    {
      "page": 8,
      "text": "Deloversikt",
      "bbox": [
        42,
        763.6397637795277,
        203.0595703125,
        794.8897637795277
      ]
    },
    {
