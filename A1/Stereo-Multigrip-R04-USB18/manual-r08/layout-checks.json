      "bbox": [
        42,
        734.6397637795277,
        77.3408203125,
        745.8897637795277
      ]
    },
    {
      "page": 9,
      "text": "Set inn begge bakhaldarane medan du støttar korta. Vent med bøylar, pinnar, kilar, kablar og",
      "bbox": [
        42,
        106.5,
        512.2197265625,
        119
      ]
    },
    {
      "page": 9,
      "text": "batteriramme.",
      "bbox": [
        42,
        91.5,
        114.412109375,
        104
      ]
    },
    {
